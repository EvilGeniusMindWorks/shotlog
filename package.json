{
  "name": "shotlog",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/server",
    "test": "npm run test -w packages/shared",
    "typecheck": "tsc --build && tsc --noEmit -p apps/web",
    "typecheck:web": "tsc --noEmit -p apps/web",
    "e2e": "node testing/run.mjs",
    "deploy": "node scripts/deploy.mjs",
    "round": "node scripts/round.mjs",
    "harness:new": "node scripts/harness-new.mjs",
    "release-notes": "node scripts/release-notes.mjs",
    "licenses": "node scripts/licenses.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "playwright": "^1.63.0"
  },
  "license": "UNLICENSED"
}
