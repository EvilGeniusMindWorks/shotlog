// ShotLog sync server — Postgres via Prisma.
//
// Design note: synced records are stored as JSONB documents keyed by
// (userId, tableName, recordId) rather than mirroring the client's 17
// tables relationally. For v1, sync = durable backup with last-write-wins;
// a document store survives client schema evolution without server
// migrations. Relational projections can be added when reporting or
// multi-user querying needs them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String       @id @default(uuid())
  name      String
  createdAt DateTime     @default(now())
  users     User[]
  records   SyncRecord[]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  /// admin | blaster | driller | mechanic | office
  role          String         @default("blaster")
  isActive      Boolean        @default(true)
  /// Personal blasting licenses: [{state, licenseNumber, expirationDate}] —
  /// one per state; travels with the login session for offline auto-fill
  licenses      Json           @default("[]")
  /// Signature on file: PNG data URL, offered at blast-log sign-off
  signature     String?
  /// Offline unlock PIN (salted SHA-256) — follows the account to any device
  pinHash       String?
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]

  @@index([companyId])
}

/// Crew enrollment invite: admin issues, crew member redeems once to
/// create their own account. Token stored hashed; link carries the raw.
model InviteToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  companyId    String
  /// Optional link to the synced crewMembers record this invite is for
  crewMemberId String?
  name         String
  email        String?
  role         String
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([companyId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// PowerSync system of record: one row per app record, JSON payload as
/// text (blob markers included), replicated to devices by the PowerSync
/// service. No FK to Company on purpose — it is a pure replication sink;
/// scoping is enforced by the API (upload) and sync rules (download).
model Record {
  id        String
  companyId String @map("company_id")
  tableName String @map("table_name")
  payload   String
  /// Informational only — write ORDER is authoritative, never timestamps
  updatedAt String @map("updated_at")

  // Composite key: ids are only unique per company. Deterministic ids
  // (e.g. the seed-* product catalog every device creates) COLLIDE across
  // companies by design — a global id PK silently dropped those writes.
  @@id([companyId, id])
  @@map("records")
}

/// Append-only audit trail written at the /powersync/upload choke point:
/// who changed which record, when it reached the server, and the field-level
/// before→after diff. DISCARD entries record rejected writes (role denials,
/// locked-day edits, write-once replays) — refusals are part of the record.
model AuditEntry {
  id        String   @id @default(uuid())
  companyId String
  tableName String
  recordId  String
  /// PUT | PATCH | DELETE | DISCARD
  op        String
  actorId   String
  actorName String
  actorRole String
  at        DateTime @default(now())
  /// [{field, old?, new?, note?}] — heavy fields recorded without values
  changes   Json     @default("[]")
  /// Discards only: why the write was rejected
  reason    String?

  @@index([companyId, at])
  @@index([companyId, recordId, at])
  @@index([companyId, actorId, at])
}

model SyncRecord {
  /// Company-scoped: every user in the company shares the same records
  companyId String
  tableName String
  recordId  String
  /// Client-side updatedAt — the LWW clock
  updatedAt DateTime
  deletedAt DateTime?
  payload   Json
  /// Server receive time (audit)
  syncedAt  DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, tableName, recordId])
  @@index([companyId, updatedAt])
  @@index([companyId, syncedAt])
}
